+enum ksu_type_lookup {
+    KSU_TYPE_INVALID = 0, /* type extracted and absent from the policy */
+    KSU_TYPE_VALID,       /* type extracted and present */
+    KSU_TYPE_DEFER,       /* degenerate name; let the full parser decide */
+};
+
+/*
+ * Fast, allocation-free type lookup against the policy used to answer
+ * app queries.
+ *
+ * The invalid-context timing probe compares payload (A), a context with an
+ * unknown type, with payload (B), the same string whose first byte is '\n'.
+ * Stock rejects both but through different code paths (A pays for the full
+ * dual-policy conversion, B skips it), so their write latencies differ and
+ * the probe can tell them apart.  Routing both payloads through this single
+ * lookup makes their latencies identical.  Contexts whose type exists still
+ * go through the full conversion below.  DEFER cases (oversized or
+ * embedded-NUL names) deliberately skip the leading-newline shortcut so
+ * that (B) performs the same conversion work as (A); every rejected payload
+ * ends at -EINVAL, as on stock.
+ */
+static enum ksu_type_lookup ksu_selinux_hide_lookup_type(struct policydb *db, const char *context, size_t size)
+{
+    const char *p, *end, *type, *type_end;
+    struct type_datum *typdatum;
+    char name[256];
+    size_t type_len;
+
+    if (!db)
+        return KSU_TYPE_DEFER;
+    if (!context || !size)
+        return KSU_TYPE_INVALID;
+
+    end = context + size;
+
+    /* Skip "user:" and "role:". */
+    p = memchr(context, ':', size);
+    if (!p)
+        return KSU_TYPE_INVALID;
+    p++;
+    p = memchr(p, ':', end - p);
+    if (!p)
+        return KSU_TYPE_INVALID;
+    p++;
+
+    type = p;
+    type_end = memchr(type, ':', end - type);
+    if (!type_end)
+        type_end = end;
+
+    type_len = (size_t)(type_end - type);
+    if (!type_len)
+        return KSU_TYPE_INVALID;
+
+    if (type_len >= sizeof(name) || memchr(type, '\0', type_len))
+        return KSU_TYPE_DEFER;
+
+    memcpy(name, type, type_len);
+    name[type_len] = '\0';
+
+    typdatum = symtab_search(&db->p_types, name);
+    return (typdatum && !typdatum->attribute) ? KSU_TYPE_VALID : KSU_TYPE_INVALID;
+}
+
+static struct policydb *ksu_hide_context_policydb(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) || defined(KSU_COMPAT_HAS_SELINUX_POLICY_STRUCT)
+    return backup_sepolicy ? &backup_sepolicy->policydb : NULL;
+#else
+    return backup_policydb;
+#endif
+}
